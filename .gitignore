# Dependencias da API — reinstale com "npm install" dentro de api/
node_modules/

# Segredos e configuracao local (ver api/config/.gitignore)
api/config/db.json
api/config/auth.secret

# Arquivos com senha em texto puro. O certo e guardar isso num gerenciador de
# senhas (Bitwarden, KeePassXC...) e apagar o arquivo — enquanto ele existir,
# fica de fora do git. Um "git add ." nao pode mandar isto para o GitHub.
senhas.txt
*senha*.txt
*senhas*.txt

# Copia do NSSM na raiz, so na VM: permite rodar
#   cd C:\guemat-estoque && git pull && nssm restart InventoryGuemat
# (o cmd acha programa na pasta atual). E um executavel de terceiros — nao
# entra no repositorio. O servico usa o C:\ferramentas\nssm.exe.
/nssm.exe

# Configuracao local da maquina (Claude Code)
.claude/settings.local.json

# Lixo de editor / sistema
Thumbs.db
desktop.ini
.DS_Store
